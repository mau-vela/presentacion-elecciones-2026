# =====================================================================
#  SECCION 01 — DIVIPOLE
# =====================================================================
fw   <- function(x, a, b) str_sub(x, a, b)
num0 <- function(x) suppressWarnings(as.numeric(str_trim(x)))
chr0 <- function(x) str_squish(x)
# --- Lector DIVIPOL 2026 (esquema comun) ----------------------------
leer_divipol <- function(ruta_basicos) {
archivo <- list.files(ruta_basicos, pattern = "^DIVIPOL.*\\.TXT$",
full.names = TRUE, ignore.case = TRUE)[1]
if (is.na(archivo)) stop("No encontre DIVIPOL en: ", ruta_basicos)
lineas <- readLines(archivo, encoding = "latin1", warn = FALSE)
tibble(linea = lineas) %>%
filter(nchar(linea) >= 146) %>%
transmute(
COD_DPTO          = num0(fw(linea, 1, 2)),
codmun            = num0(fw(linea, 3, 5)),
zona              = num0(fw(linea, 6, 7)),
puesto            = str_pad(chr0(fw(linea, 8, 9)), 2, pad = "0"),
Depto_divipol     = chr0(fw(linea, 10, 21)),
Municipio_divipol = chr0(fw(linea, 22, 51)),
nompuesto         = chr0(fw(linea, 52, 91)),
potencial_hombres = num0(fw(linea, 93, 100)),
potencial_mujeres = num0(fw(linea, 101, 108)),
n_mesas_puesto    = num0(fw(linea, 109, 114))
) %>%
mutate(censo = potencial_hombres + potencial_mujeres,
code_RNEC = COD_DPTO * 1000 + codmun) %>%
distinct(code_RNEC, zona, puesto, .keep_all = TRUE)
}
# --- Corrige censo artificial del exterior (puestos 81-86) ----------
# Opera sobre el esquema comun (sirve para 2026 y para historico).
corregir_censo_exterior <- function(df) {
df %>% mutate(
art = COD_DPTO == 88 & as.character(puesto) %in% as.character(81:86),
potencial_hombres = ifelse(art, NA_real_, potencial_hombres),
potencial_mujeres = ifelse(art, NA_real_, potencial_mujeres),
censo             = ifelse(art, NA_real_, censo)
) %>% select(-art)
}
# --- Normaliza un censo historico al esquema comun ------------------
norm_hist <- function(df) {
df %>% transmute(
COD_DPTO          = as.numeric(coddepto),
codmun            = as.numeric(codmun),
zona              = as.numeric(zona),
puesto            = as.character(puesto),
potencial_hombres = as.numeric(hombres),
potencial_mujeres = as.numeric(mujeres),
censo             = as.numeric(censo),
n_mesas_puesto    = NA_real_,          # el historico no siempre trae mesas
code_RNEC         = as.numeric(coddepto) * 1000 + as.numeric(codmun)
)
}
# --- Leer 2026 ------------------------------------------------------
divipol_cong_26 <- leer_divipol(ruta_basicos_cong) %>% corregir_censo_exterior()
divipol_pres_26 <- leer_divipol(ruta_basicos_pres) %>% corregir_censo_exterior()
# --- Leer HISTORICO 2018 / 2022 (reads sacados de tu rmd) -----------
rp <- function(...) file.path(ruta_participacion, "datos", ...)
# 2018 Congreso (fixed-width)
censo_congreso_2018 <- read_fwf(rp("DIVIPOL_20180223_111842_01_UNIFICADO.txt"),
fwf_widths(c(2,3,2,2,12,30,40,1,8,8,6,102),
c("coddepto","codmun","zona","puesto","nomdepto","nommun","nompuesto","flag","mujeres","hombres","mesas","comuna")),
locale = locale(encoding = "Latin1"), col_types = cols(.default = col_character())) %>%
mutate(coddepto = as.integer(coddepto), codmun = as.integer(codmun), zona = as.integer(zona),
puesto = str_remove(puesto, "^0+(?!$)"),
mujeres = as.integer(mujeres), hombres = as.integer(hombres), censo = mujeres + hombres)
# 2018 Presidencia (base madre + consulados)
censo_pres_2018 <- read_excel(rp("Divipol Presidente 2018.xlsx"), sheet = "Base Madre ", range = "A1:N10999") %>%
transmute(coddepto = as.numeric(`Code Depto`), codmun = as.numeric(`Code Muni`), zona = as.numeric(Zona),
puesto = Puesto, hombres = as.integer(hombres), mujeres = as.integer(mujeres), censo = as.integer(total)) %>%
mutate(puesto = str_remove(puesto, "^0+(?!$)"))
censo_pres_consulados_2018 <- read_excel(rp("Divipol Presidente 2018.xlsx"), sheet = "Consulados ", range = "A1:L233") %>%
transmute(coddepto = as.numeric(dd), codmun = as.numeric(mm), zona = as.numeric(zz),
puesto = pp, hombres = as.integer(hombres), mujeres = as.integer(mujeres), censo = as.integer(total)) %>%
mutate(puesto = str_remove(puesto, "^0+(?!$)"))
censo_pres_2018 <- bind_rows(censo_pres_2018 %>% filter(coddepto != 88), censo_pres_consulados_2018)
# 2022 Congreso
censo_congreso_2022 <- read_excel(rp("Divipole_Elecciones_Congreso_13-03-2022.xlsx"),
sheet = "divipol_20220207_161440", range = "A5:L12517") %>%
transmute(coddepto = as.numeric(dd), codmun = as.numeric(mm), zona = as.numeric(zz),
puesto = pp, hombres, mujeres, censo = total) %>%
mutate(puesto = str_remove(puesto, "^0+(?!$)"))
# 2022 Presidencia
censo_pres_2022 <- read_excel(rp("Divipole_Elección_Presidente_2022.xlsx"),
sheet = "divipol_20220422_222259", range = "A5:O12518") %>%
transmute(coddepto = as.numeric(dd), codmun = as.numeric(mm), zona = as.numeric(zz),
puesto = pp, hombres = as.integer(hombres), mujeres = as.integer(mujeres), censo = as.integer(total)) %>%
mutate(puesto = str_remove(puesto, "^0+(?!$)"))
# Normalizar + corregir exterior
cong_2018 <- censo_congreso_2018 %>% norm_hist() %>% corregir_censo_exterior()
cong_2022 <- censo_congreso_2022 %>% norm_hist() %>% corregir_censo_exterior()
pres_2018 <- censo_pres_2018     %>% norm_hist() %>% corregir_censo_exterior()
pres_2022 <- censo_pres_2022     %>% norm_hist() %>% corregir_censo_exterior()
# ---- (A) Resumen nacional / exterior, por eleccion y anio ----------
resumir_ambito <- function(df, eleccion, annoh) {
df %>%
mutate(ambito = ifelse(COD_DPTO == 88, "Exterior", "Nacional")) %>%
group_by(ambito) %>%
summarise(
n_puestos = n_distinct(paste(code_RNEC, zona, puesto)),
n_mesas   = if (all(is.na(n_mesas_puesto))) NA_real_ else sum(n_mesas_puesto, na.rm = TRUE),
censo     = sum(censo, na.rm = TRUE),
censo_h   = sum(potencial_hombres, na.rm = TRUE),
censo_m   = sum(potencial_mujeres, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(eleccion = eleccion, annoh = annoh, .before = 1)
}
div_resumen <- bind_rows(
resumir_ambito(divipol_cong_26, "Congreso",    2026),
resumir_ambito(divipol_pres_26, "Presidencia", 2026),
resumir_ambito(cong_2018,       "Congreso",    2018),
resumir_ambito(cong_2022,       "Congreso",    2022),
resumir_ambito(pres_2018,       "Presidencia", 2018),
resumir_ambito(pres_2022,       "Presidencia", 2022)
)
# ---- (B) Municipio y departamento 2026 (para el mapa) --------------
resumir_mpio <- function(df, eleccion) {
df %>%
filter(COD_DPTO != 88) %>%
group_by(code_RNEC) %>%
summarise(
n_puestos = n_distinct(paste(zona, puesto)),
n_mesas   = sum(n_mesas_puesto, na.rm = TRUE),
censo     = sum(censo, na.rm = TRUE),
censo_h   = sum(potencial_hombres, na.rm = TRUE),
censo_m   = sum(potencial_mujeres, na.rm = TRUE),
.groups = "drop"
) %>%
left_join(map_rnec_codmpio, by = "code_RNEC") %>%
filter(!is.na(codmpio)) %>%
mutate(eleccion = eleccion)
}
div_mpio_2026 <- bind_rows(
resumir_mpio(divipol_cong_26, "Congreso"),
resumir_mpio(divipol_pres_26, "Presidencia")
)
div_depto_2026 <- div_mpio_2026 %>%
mutate(coddepto = floor(codmpio / 1000)) %>%           # <- llave del sf_deptos
group_by(eleccion, coddepto) %>%
summarise(across(c(n_puestos, n_mesas, censo, censo_h, censo_m), \(x) sum(x, na.rm = TRUE)),
.groups = "drop") %>%
left_join(map_depto_nom, by = "coddepto")               # nombre del depto para el popup
# ---- (C) Exterior por pais 2026 ------------------------------------
resumir_pais <- function(df, eleccion) {
df %>%
filter(COD_DPTO == 88) %>%
mutate(pais = coalesce(na_if(Depto_divipol, ""), Municipio_divipol)) %>%
group_by(pais) %>%
summarise(
n_puestos = n_distinct(paste(code_RNEC, zona, puesto)),
n_mesas   = sum(n_mesas_puesto, na.rm = TRUE),
censo     = sum(censo, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(desc(censo)) %>%
mutate(eleccion = eleccion)
}
div_ext_pais <- bind_rows(
resumir_pais(divipol_cong_26, "Congreso"),
resumir_pais(divipol_pres_26, "Presidencia")
)
# ---- (D) Puestos nuevos vs. viejos (2026 vs 2022) ------------------
id_puesto <- function(d) d %>% distinct(code_RNEC, zona, puesto = as.character(puesto))
nuevos_de <- function(d26, dhist, eleccion) {
tibble(
eleccion = eleccion,
n_nuevos     = nrow(anti_join(id_puesto(d26), id_puesto(dhist), by = c("code_RNEC","zona","puesto"))),
n_eliminados = nrow(anti_join(id_puesto(dhist), id_puesto(d26), by = c("code_RNEC","zona","puesto")))
)
}
div_nuevos_resumen <- bind_rows(
nuevos_de(divipol_cong_26, cong_2022, "Congreso"),
nuevos_de(divipol_pres_26, pres_2022, "Presidencia")
)
# ---- GUARDAR -------------------------------------------------------
datos_divipole <- list(
resumen    = div_resumen,
mpio_2026  = div_mpio_2026,
depto_2026 = div_depto_2026,
ext_pais   = div_ext_pais,
nuevos     = div_nuevos_resumen
)
saveRDS(datos_divipole, "datos_divipole.rds")
message("Listo: datos_divipole.rds generado.")
